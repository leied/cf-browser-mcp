{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "browser-mcp",
  "main": "src/index.ts",
  // Bump this whenever you redeploy — quickAction() needs 2026-03-24 or later.
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare Browser Run (headless Chrome). Quick Actions — markdown,
  // content, snapshot, links, pdf — are called via env.BROWSER.quickAction()
  // with no extra auth needed; the binding handles it.
  "browser": {
    "binding": "BROWSER",
  },

  // Workers KV namespace storing the domain + Instagram-username blocklist.
  // Create it with:
  //   npx wrangler kv namespace create BLOCKLIST_KV
  // then paste the returned id below (and the preview_id for `wrangler dev`).
  "kv_namespaces": [
    {
      "binding": "BLOCKLIST_KV",
      "id": "dd1b51fe62874dbe8a3935a955798810",
      "preview_id": "48448de39eb8453caa844f2a69ea83ae",
    },
    // Used by @cloudflare/workers-oauth-provider to store auth codes and tokens.
    // Create with: npx wrangler kv namespace create OAUTH_KV
    {
      "binding": "OAUTH_KV",
      "id": "c1a1850b80e04a0590315a2c6bc05811",
      "preview_id": "5ec77cef9e674d248fb00fc65ad1b0d1",
    },
  ],

  // Durable Object backing the MCP server — one instance per client session.
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "BrowserMcp",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BrowserMcp"],
    },
  ],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
